# Public browser configuration only. Never put secrets in VITE_* variables.
# The frontend and backend run as separate servers and connect through this URL.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Local Vite dev server. Read by vite.config.ts (not exposed to the browser).
DEV_SERVER_PORT=5173
DEV_API_PROXY_TARGET=http://localhost:5000

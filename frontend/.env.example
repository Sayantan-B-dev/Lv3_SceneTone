# Public browser configuration only. Never put secrets in VITE_* variables.
#
# Two independent services: the app backend owns Google sign-in, sessions and
# projects; the AI service owns /ai/blueprint, /ai/mix-report and /ai/guide.
# Both URLs include the /api/v1 prefix and may live on different hosts.
VITE_APP_API_URL=https://YOUR-APP-WORKER.workers.dev/api/v1
VITE_AI_API_URL=https://scenetone-api.sayantanbharati4.workers.dev/api/v1

# Optional legacy name for the app backend. Used only when VITE_APP_API_URL is
# empty; leave it out when the two variables above are set.
# VITE_API_BASE_URL=http://localhost:5000/api/v1

# Local Vite dev server. Read by vite.config.ts (not exposed to the browser).
# Leave both VITE_* URLs empty to send everything through this local proxy.
DEV_SERVER_PORT=5173
DEV_API_PROXY_TARGET=http://localhost:5000

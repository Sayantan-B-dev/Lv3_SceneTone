# Local development example. Copy to .env and fill values. Never commit .env.

NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Local MongoDB is the default for development. Use the Atlas URI when deployed.
MONGODB_URI=mongodb://127.0.0.1:27017/scenetone

# Minimum 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Identity Services. The backend verifies ID tokens against this client id.
GOOGLE_CLIENT_ID=

# Optional: only if your OAuth flow requires a client secret. Backend-only.
GOOGLE_CLIENT_SECRET=

# Google OAuth redirect URI for the optional redirect-mode flow. Must match the value
# authorised in the Google Cloud console.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback


# Adaption AI provider. Server-side only; optional when OpenRouter is configured.
ADAPTION_API_KEY=
ADAPTION_BASE_URL=
ADAPTION_MODEL=

# OpenRouter fallback provider. Keys are tried in order, one request at a time.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Timeout for a single provider attempt.
AI_REQUEST_TIMEOUT_MS=30000
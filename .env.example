NODE_ENV=development
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/scenetone
SESSION_SECRET=<at least 32 random characters>
GOOGLE_CLIENT_ID=<Google OAuth client id>
GOOGLE_CLIENT_SECRET=<Google OAuth client secret, server-only>
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
ADAPTION_API_KEY=<server-only, optional when OpenRouter is set>
ADAPTION_BASE_URL=<Adaption base URL>
ADAPTION_MODEL=<current model id>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_API_KEY_1=<server-only>
OPENROUTER_API_KEY_2=<server-only, fallback>
OPENROUTER_API_KEY_3=<server-only, fallback>
AI_REQUEST_TIMEOUT_MS=30000
